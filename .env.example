# FILE: /.env.example
# Copy this file to .env and configure your settings

# Application
APP_NAME=SplashMarketingAI
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=splashmarketingai
DB_USERNAME=root
DB_PASSWORD=

# Mail Settings (for email campaigns)
MAIL_FROM_EMAIL=noreply@splashmarketingai.local
MAIL_FROM_NAME=SplashMarketingAI
MAIL_SMTP_HOST=smtp.mailtrap.io
MAIL_SMTP_PORT=2525
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls

# SMS Settings (for SMS campaigns)
SMS_FROM_PHONE=+1234567890
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=

# AI Settings (for content generation)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4

# Session
SESSION_LIFETIME=7200

# Security
CSRF_ENABLED=true
PASSWORD_MIN_LENGTH=8

# Upload Limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_CSV_TYPES=csv,txt

# Timezone
APP_TIMEZONE=UTC
